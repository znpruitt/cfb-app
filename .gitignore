# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output
/.next/
/out/

# production build
/build

# misc system files
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript artifacts
*.tsbuildinfo
next-env.d.ts

# IDE/editor settings
.vscode/
# Local multi-worktree VS Code layouts (they reference sibling checkouts by path).
*.code-workspace
.idea/
*.swp

# lint/test caches
.eslintcache
jest-test-results.json
markdownlint-errors*.txt

# -----------------------------
# Project-specific data
# -----------------------------

# Keep aliases under version control
# (do NOT ignore data/aliases-*.json)

# Ignore transient data files if any
# (but keep your canonical teams catalog)
data/*.json
!data/teams-*.json
!data/aliases-*.json

# Vercel plugin / env files the explicit list above misses (e.g. `.env.vercel`)
.env*
!.env.example

# POLISH-004 — owner-supplied art-direction references. Deliberately NOT committed:
# they are inspiration for a design pass, not production assets, and one is a
# 1.4 MB raster the app never loads.
/references/
/homepage_reference_image.png
